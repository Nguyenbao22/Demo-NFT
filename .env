# ============================================================
#  .env.example  –  Copy to .env and fill in your real values.
#                   NEVER commit .env to version control!
# ============================================================

# ── Ethereum / Sepolia ───────────────────────────────────────
# Your wallet's private key WITHOUT the leading 0x
PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC endpoint from Infura or Alchemy (Sepolia network)
# Infura:  https://sepolia.infura.io/v3/<YOUR_PROJECT_ID>
# Alchemy: https://eth-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/BdPnnyEmx1JAiMfjA8VR_

# Address of the deployed ImageNFT contract on Sepolia
CONTRACT_ADDRESS=0x9C1b87AB0C507E77D7B1e5C8b2297518aFC9E0c1

# Path to the compiled ABI JSON (relative to backend/)
CONTRACT_ABI_PATH=ImageNFT.abi.json

# ── Pinata (IPFS) ────────────────────────────────────────────
# JWT from https://app.pinata.cloud/keys  (use the "JWT" token, not the legacy API key)
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..SLeu781kzRIB8ZtRWrthkJ7mx4E-0C9MrLr5smsFDS8

# ── Flask / CORS ─────────────────────────────────────────────
# The origin of your frontend (adjust for production)
ALLOWED_ORIGIN=http://localhost:5500

# ── Etherscan (optional – for contract verification) ─────────
ETHERSCAN_API_KEY=your_etherscan_api_key_here
